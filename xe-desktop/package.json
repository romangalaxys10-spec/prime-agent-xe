{
  "name": "@prime-agent-xe/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Prime Agent XE Desktop — Electron + web UI bridge to the prime-agent CLI (mirrors OpenCode desktop).",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
